# =============================================================
# env.example — Template de configuration
# Copier vers .env et remplir les valeurs (surtout les secrets).
# =============================================================

# PostgreSQL — Docker crée tout ça automatiquement
POSTGRES_DB=jumia_db
POSTGRES_USER=jumia_user
POSTGRES_PASSWORD=changeme

# URL complète pour Flask et Celery (hors Docker)
# En Docker, docker-compose.yml utilise postgres:5432 automatiquement
DATABASE_URL=postgresql://jumia_user:changeme@localhost:5433/jumia_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Flask
FLASK_DEBUG=true
FLASK_ENV=development
# En prod, générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_use_a_random_32_char_string

# Grafana (UI : http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Scraping (respect de la charte éthique)
SCRAPE_INTERVAL_HOURS=24
MAX_ITEMS_PER_CATEGORY=50

# Gmail SMTP (pour les alertes de prix)
# 1. Activer la validation en 2 étapes sur votre compte Google
# 2. Créer un mot de passe d'application : https://myaccount.google.com/apppasswords
# 3. Le mot de passe d'application est composé de 4 groupes de 4 caractères
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Assistant IA (Groq + Llama)
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30

# Apache Airflow (UI : http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123
# Générer une nouvelle clé avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# FlareSolverr (contournement Cloudflare pour Jumia)
# URL interne Docker (ne pas changer sauf changement d'archi)
FLARESOLVERR_URL=http://flaresolverr:8191/v1
