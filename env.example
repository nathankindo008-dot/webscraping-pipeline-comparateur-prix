# =============================================================
# .env.example — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# IMPORTANT : ne jamais committer le fichier .env
# =============================================================

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=jumia_db
POSTGRES_USER=jumia_user
POSTGRES_PASSWORD=jumia_pass          # ← changer en prod

# ── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Flask ───────────────────────────────────
FLASK_DEBUG=false
FLASK_ENV=production
SECRET_KEY=changeme_in_production     # ← changer en prod

# ── Celery ──────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Grafana ─────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123             # ← changer en prod

# ── Scraping ────────────────────────────────
SCRAPE_INTERVAL_HOURS=24              # fréquence de scrape
MAX_ITEMS_PER_CATEGORY=50
